---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import T from '../../components/T.astro';
import Bi from '../../components/Bi.astro';
import ui from '../../i18n/ui.json';

export async function getStaticPaths() {
  const courses = await getCollection('courses');
  return courses.map(c => ({ params: { course: c.id }, props: { course: c } }));
}
const { course } = Astro.props;
const d = course.data;
const dayName = (day) => ui[`day.${day}`];
const topics = [...d.topics].sort((a, b) => a.order - b.order);
const syllabus = (await getCollection('syllabus')).map(s => s.data).filter(s => s.course === course.id).sort((a, b) => a.date.localeCompare(b.date));
const briefs = (await getCollection('briefs')).filter(b => b.data.course === course.id).sort((a, b) => a.data.title.localeCompare(b.data.title));
const briefById = Object.fromEntries(briefs.map(b => [b.id, b]));
const notes = (await getCollection('notes')).filter(n => n.data.course === course.id);
const noteById = Object.fromEntries(notes.map(n => [n.id, n]));
const quizzes = (await getCollection('quizzes')).filter(q => q.data.course === course.id);
const exercises = (await getCollection('exercises')).filter(e => e.data.course === course.id);
const bookShort = (bookId) => d.books.find(b => b.id === bookId)?.short || bookId;
---
<Base title={d.title.en}>
  <header class="course-head">
    <div class="kicker" style="display:flex; align-items:center; gap:10px;">
      <span class="code" data-size="sm" style={`--cc: var(--${d.color}); --cc-ink: var(--${d.color}-ink)`} aria-hidden="true">{d.code}</span>
      <span>{d.professor.title ? `${d.professor.title} ` : ''}{d.professor.name}</span>
    </div>
    <h1><Bi v={d.title} /></h1>
    {d.about && <p class="prose"><Bi v={d.about} /></p>}
  </header>

  <section class="sec">
    <div class="sec-head"><h2><T k="course.meets" /></h2></div>
    <ul class="list">
      {d.meetings.map(m => (
        <li><strong class="ui"><Bi v={dayName(m.day)} /></strong> <span class="num">{m.start}–{m.end}</span>{m.room ? `, ${m.room}` : ''}</li>
      ))}
    </ul>
  </section>

  {d.extras.length > 0 && (
    <section class="sec">
      <ul class="list">
        {d.extras.map(x => <li><strong class="ui"><Bi v={x.label} /></strong>: <Bi v={dayName(x.day)} /> <span class="num">{x.start}–{x.end}</span>{x.room ? `, ${x.room}` : ''}</li>)}
      </ul>
    </section>
  )}

  <section class="sec">
    <div class="sec-head"><h2><T k="course.readings" /></h2><label class="check inline small"><input type="checkbox" id="show-past" /><span class="box" aria-hidden="true"></span><span class="text"><T k="course.showPast" /></span></label></div>
    {syllabus.length === 0 ? (
      <div class="empty"><p><T k="today.readingsSoon" /></p></div>
    ) : (
      <ul class="agenda" id="course-agenda">
        {syllabus.map(s => (
          <li data-date={s.date}>
            <span class="when num" data-when={s.date}>{s.date}</span>
            <div class="what">
              <span class="kind"><T k={`type.${s.type}`} />{s.time ? ` · ${s.time.start}–${s.time.end}` : ''}{s.due ? <> · <T k="today.due" /> <span class="num">{s.due}</span></> : ''}</span>
              <span class="rtitle"><Bi v={s.title} /></span>
              {s.pages.length > 0 && <span class="rpages">{s.pages.map((p, i) => (<span>{i > 0 ? '; ' : ''}<b>{bookShort(p.book)}</b> {p.pages ?? p.sections}{p.note ? ` (${p.note})` : ''}</span>))}</span>}
              {s.briefs.length > 0 && <span class="rpages">{s.briefs.map((id, i) => briefById[id] && (<span>{i > 0 ? ' · ' : ''}<a href={`/briefs/${id}/`}>{briefById[id].data.title}</a></span>))}</span>}
              {s.notes.length > 0 && <span class="rpages">{s.notes.map((id, i) => noteById[id] && (<span>{i > 0 ? ' · ' : ''}<a href={`/notes/${id}/`}><Bi v={noteById[id].data.title} /></a></span>))}</span>}
              {s.note && <span class="rnote"><Bi v={s.note} /></span>}
              {!s.verified && <span class="tag"><T k="course.unverified" /></span>}
            </div>
          </li>
        ))}
      </ul>
    )}
  </section>

  <section class="sec">
    <div class="sec-head"><h2><T k="course.briefs" /></h2></div>
    {briefs.length === 0 ? <p class="muted small"><T k="course.noBriefs" /></p> : (
      <ul class="list">{briefs.map(b => <li><a href={`/briefs/${b.id}/`}>{b.data.title}</a> <span class="muted small">({b.data.year})</span> <span class="tag"><T k={`brief.status.${b.data.status}`} /></span></li>)}</ul>
    )}
  </section>

  {notes.length > 0 && (
    <section class="sec">
      <div class="sec-head"><h2><T k="course.notes" /></h2></div>
      <ul class="list">{notes.map(n => <li><a href={`/notes/${n.id}/`}><Bi v={n.data.title} /></a> <span class="tag">{n.data.kind}</span></li>)}</ul>
    </section>
  )}

  {(quizzes.length > 0 || exercises.length > 0) && (
    <section class="sec">
      <div class="sec-head"><h2><T k="course.practice" /></h2></div>
      <ul class="list">
        {quizzes.map(q => <li><a href={`/quiz/${q.id}/`}><Bi v={q.data.title} /></a> <span class="muted small num">{q.data.questions.length} <T k="quiz.questions" /></span></li>)}
        {exercises.map(e => <li><a href={`/exercises/${e.id}/`}><Bi v={e.data.title} /></a> <span class="tag"><T k={`exercise.kind.${e.data.kind}`} /></span></li>)}
      </ul>
    </section>
  )}

  <script>
    import { todayISO, formatDate } from '../../lib/dates.js';
    import { lang, onLangChange } from '../../lib/i18n.js';
    import { prefs, setPref } from '../../lib/store.js';
    const toggle = document.getElementById('show-past');
    const rows = [...document.querySelectorAll('#course-agenda > li')];
    if (toggle) {
      toggle.checked = Boolean(prefs().showPast);
      const paint = () => {
        const today = todayISO(); const L = lang();
        rows.forEach(li => { const past = li.dataset.date < today; li.hidden = past && !toggle.checked; li.classList.toggle('is-today', li.dataset.date === today); li.querySelector('[data-when]').textContent = formatDate(li.dataset.date, L); });
      };
      toggle.addEventListener('change', () => { setPref('showPast', toggle.checked); paint(); });
      paint(); onLangChange(paint);
    }
  </script>

  <section class="sec">
    <div class="sec-head"><h2><T k="course.topics" /></h2></div>
    <ol class="list">
      {topics.map(tp => (
        <li><Bi v={tp.title} />{tp.barTested && <> <span class="tag"><T k="course.barTag" /></span></>}</li>
      ))}
    </ol>
  </section>

  <section class="sec">
    <div class="sec-head"><h2><T k="course.books" /></h2></div>
    <ul class="books">
      {d.books.map(b => (
        <li>
          <div>{b.cite}{!b.verified && <> <span class="tag"><T k="course.unverified" /></span></>}</div>
          <div class="role"><Bi v={ui[`role.${b.role}`]} /></div>
        </li>
      ))}
    </ul>
    <p class="muted" style="font-size: 14px;"><T k="course.booksNote" /></p>
  </section>

  <section class="sec">
    <div class="sec-head"><h2><T k="course.assessment" /></h2></div>
    <dl class="kv">
      {d.assessment.map(a => (
        <>
          <dt><Bi v={ui[`assessment.${a.kind}`]} /></dt>
          <dd>{a.format ? <Bi v={a.format} /> : ''}{a.weight ? ` (${a.weight})` : ''}{!a.verified && <> <span class="tag"><T k="course.unverified" /></span></>}</dd>
        </>
      ))}
    </dl>
  </section>

  <section class="sec">
    <div class="sec-head"><h2><T k="course.materials" /></h2></div>
    <p>{d.materials.canvas ? <T k="course.canvas" /> : <T k="course.noCanvas" />}. {d.materials.note && <Bi v={d.materials.note} />}</p>
  </section>
</Base>
